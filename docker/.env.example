# Copie para docker/.env (o .env não vai para o git)
# Reserva bancária inicial da UniFIAP Pay no BACEN, em reais
RESERVA_BANCARIA_SALDO=1000000.00

# Porta da API no host (a API escuta 8080 dentro do container)
API_HOST_PORT=8080

# Intervalo, em segundos, da auditoria em modo contínuo
MONITORING_INTERVAL=60
